# Salin ke .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.
# Jangan commit file berisi nilai asli.

# URL channel milik Anda untuk tombol "Kunjungi", format: https://whatsapp.com/channel/ID_CHANNEL
WHATSAPP_CHANNEL_URL=

# Rahasia acak panjang untuk menandatangani cookie sesi di middleware (mis. hasil `openssl rand -hex 32`)
SESSION_SECRET=

# Opsional: origin tambahan yang boleh memanggil API (pisahkan koma), mis. domain kustom
ALLOWED_ORIGINS=

# Opsional: rate limit server per IP (default 10 permintaan / 600 detik)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SEC=600

# ----------------------------------------------------------------
# Provider reaction (versi scrape) — api/rch.js via lib/panel.js
# ----------------------------------------------------------------

# Opsional: alamat panel reaction (default https://react.nexapanel.my.id)
REACT_PROVIDER_BASE=

# Opsional: mode mesin. auto (default) = http -> browser; http-only; browser-only
REACT_PROVIDER_MODE=

# Opsional: daftar proxy bersih (sangat disarankan di Vercel; koma/baris), format:
#   http://user:pass@host:port, socks5://user:pass@host:port
PROXY_LIST=

# Opsional: URL sumber daftar proxy (txt/json) untuk penggantian proxy otomatis
PROXY_SOURCE_URL=

# Opsional: ukuran pool & kuota per proxy (default 100 slot; 100 pakai per proxy)
PROXY_SLOTS=100
PROXY_MAX_USES=100

# Opsional: "0" menonaktifkan sumber proxy gratis publik (default aktif)
SCRAPER_FREE_PROXIES=1

# Opsional: tuning mesin (jumlah percobaan & anggaran waktu, ms)
REACT_HTTP_ATTEMPTS=2
REACT_BROWSER_ATTEMPTS=
REACT_SOLVE_WAIT_MS=25000
REACT_RESULT_WAIT_MS=20000
REACT_TOTAL_BUDGET_MS=
